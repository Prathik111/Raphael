{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Ecosystem",
  "version": "0.1.0",
  "identifier": "com.aiecosystem.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AI Ecosystem",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:*"
    }
  },
"bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
