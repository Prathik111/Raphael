<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Raphael HUD Prototype</title>
<style>
  :root { color-scheme: dark; --fg:#f4f7f7; --muted:rgba(226,236,244,.62); --line:rgba(255,255,255,.28); --panel:rgba(0,0,0,.72); }
  html, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; background:#030b08; color:var(--fg); font-family:Consolas,"Cascadia Mono",ui-monospace,monospace; }
  body { position:relative; transition:filter 380ms ease,transform 380ms ease; }
  body.startup-intro { filter:blur(28px) brightness(.12); transform:scale(1.08); }
  #canvas-wrap, #fallback-visual { position:fixed; inset:0; width:100%; height:100%; }
  #canvas-wrap { z-index:0; }
  #canvas-wrap canvas { display:block; width:100%; height:100%; }
  #fallback-visual { z-index:1; pointer-events:none; opacity:1; transition:opacity 400ms ease; background:radial-gradient(circle at 50% 33%,rgba(19,100,73,.20),transparent 30%),linear-gradient(180deg,#020807 0%,#030b08 52%,#010504 100%); }
  body.three-ready #fallback-visual { opacity:0; }
  #fallback-core { position:absolute; left:50%; top:34%; width:min(52vw,580px); aspect-ratio:1; transform:translate(-50%,-50%); filter:drop-shadow(0 0 20px rgba(95,255,194,.22)); }
  #fallback-core .orbit { fill:none; stroke:rgba(205,255,238,.42); stroke-width:1.2; }
  #fallback-core .orbit2 { transform-origin:center; animation:orbit 13s linear infinite; }
  #fallback-core .core { fill:none; stroke:rgba(255,255,255,.82); stroke-width:1.5; }
  #fallback-core .core2 { fill:none; stroke:rgba(171,255,222,.26); stroke-width:1; }
  #fallback-core .glow { fill:rgba(227,255,244,.06); stroke:rgba(242,255,249,.7); stroke-width:1; }
  #fallback-core .dot { fill:#fff; }
  @keyframes orbit { to { transform:rotate(360deg); } }
  #brand { position:fixed; z-index:12; top:20px; left:24px; display:flex; align-items:center; gap:10px; pointer-events:none; }
  #brand-mark { width:30px; height:30px; border:1px solid rgba(255,255,255,.7); display:flex; align-items:center; justify-content:center; font-size:15px; }
  #brand-text { letter-spacing:.30em; font-size:12px; font-weight:600; }
  #brand-sub { display:block; margin-top:4px; letter-spacing:.24em; font-size:8px; opacity:.5; }
  #status { position:fixed; z-index:12; left:24px; bottom:18px; font-size:9px; letter-spacing:.10em; color:rgba(255,255,255,.42); pointer-events:none; }
  #quick-dock { position:fixed; z-index:12; left:50%; bottom:18px; transform:translateX(-50%); display:flex; align-items:center; gap:6px; padding:7px 8px; border:1px solid rgba(255,255,255,.16); background:rgba(0,0,0,.30); backdrop-filter:blur(3px); }
  .quick-btn { border:1px solid rgba(255,255,255,.22); background:rgba(0,0,0,.65); color:rgba(236,245,246,.78); padding:5px 10px; font-size:9px; letter-spacing:.12em; cursor:pointer; }
  .quick-btn:hover { color:#fff; border-color:rgba(255,255,255,.65); }
  #quick-perf { font-size:8px; opacity:.45; padding-left:5px; white-space:nowrap; }
  #core-hit { position:fixed; left:50%; top:34%; width:min(30vw,360px); height:min(30vw,360px); transform:translate(-50%,-50%); z-index:6; border:0; background:transparent; cursor:pointer; }
  #radial-menu { position:fixed; z-index:14; left:50%; top:34%; width:min(34vw,430px); height:min(34vw,430px); transform:translate(-50%,-50%); pointer-events:none; opacity:0; transition:opacity 180ms ease; }
  #radial-menu.open { opacity:1; pointer-events:auto; }
  .radial-item { position:absolute; width:82px; height:30px; background:#000; color:#fff; border:1px solid rgba(255,255,255,.42); font:9px Consolas,monospace; letter-spacing:.13em; cursor:pointer; transform:translate(-50%,-50%); }
  .radial-item:hover { border-color:#fff; background:#0d1411; }
  .radial-item:nth-child(1){left:50%;top:4%;}.radial-item:nth-child(2){left:96%;top:50%;}.radial-item:nth-child(3){left:50%;top:96%;}.radial-item:nth-child(4){left:4%;top:50%;}
  #center-panel-overlay { position:fixed; inset:0; z-index:20; display:flex; align-items:center; justify-content:center; opacity:0; pointer-events:none; transition:opacity:240ms ease; background:rgba(0,0,0,.12); }
  #center-panel-overlay.open { opacity:1; pointer-events:auto; }
  #center-panel-frame { position:relative; width:100vw; height:68vh; border-top:1px solid rgba(255,255,255,.5); border-bottom:1px solid rgba(255,255,255,.5); background:rgba(0,0,0,.78); box-shadow:0 0 0 1px rgba(255,255,255,.05),0 0 50px rgba(0,0,0,.35); animation:none; }
  #center-panel { height:100%; overflow:auto; padding:38px 26px 24px; box-sizing:border-box; font-size:12px; line-height:1.6; }
  #center-panel-close { position:absolute; right:10px; top:8px; z-index:3; border:1px solid rgba(255,255,255,.28); background:#000; color:#fff; width:28px; height:24px; cursor:pointer; }
  #center-panel h2,#center-panel h3,#center-panel h4 { margin:0 0 8px; letter-spacing:.16em; font-weight:400; }
  #chat-layout { display:flex; gap:18px; max-width:1180px; margin:0 auto; min-height:100%; }
  #chat-sidebar { flex:0 0 190px; border-right:1px solid rgba(255,255,255,.12); padding-right:14px; }
  #chat-sidebar button,#chat-send,#think-toggle { width:100%; background:#000; color:#fff; border:1px solid rgba(255,255,255,.24); padding:6px 8px; cursor:pointer; font-size:10px; letter-spacing:.1em; }
  #chat-sidebar button:hover,#chat-send:hover,#think-toggle:hover { border-color:rgba(255,255,255,.7); }
  #topic-list { margin-top:12px; }
  .topic-item { padding:6px 4px; opacity:.7; cursor:pointer; border-left:2px solid transparent; font-size:10px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .topic-item.active,.topic-item:hover { opacity:1; border-left-color:#fff; background:rgba(255,255,255,.05); }
  #panel-section-chat { flex:1; display:flex; flex-direction:column; min-width:0; }
  #chat-identity-name { font-size:10px; opacity:.62; letter-spacing:.16em; margin-bottom:8px; }
  #history-list { flex:1; overflow:auto; padding-right:8px; }
  .history-entry { max-width:78%; padding:7px 10px; margin:0 0 12px; border-left:2px solid rgba(255,255,255,.24); }
  .history-entry.user { margin-left:auto; text-align:right; border-left:0; border-right:2px solid rgba(255,255,255,.42); background:rgba(255,255,255,.035); }
  .history-entry .role-label { display:block; font-size:9px; opacity:.55; letter-spacing:.1em; margin-bottom:2px; }
  #chat-bar { margin-top:10px; padding:7px 9px; border:1px solid rgba(255,255,255,.28); background:rgba(0,0,0,.62); }
  #chat-input-row { display:flex; align-items:center; gap:8px; }
  #chat-input { flex:1; min-width:0; border:0; outline:none; background:none; color:#fff; padding:4px 2px; }
  #chat-send,#think-toggle { width:auto; }
  #ws-status { font-size:9px; opacity:.45; padding-left:8px; }
  #caption-box { position:fixed; z-index:15; left:50%; top:13%; transform:translateX(-50%); width:min(70%,640px); padding:16px 26px; border:2px solid #fff; color:#fff; font-size:16px; line-height:1.5; text-align:center; background:#000; opacity:0; pointer-events:none; }
  #caption-box.show { opacity:1; }
  #caption-text { white-space:pre-wrap; }
  #error-toast { position:fixed; z-index:30; right:16px; top:16px; max-width:420px; padding:8px 11px; border:1px solid rgba(255,255,255,.3); background:rgba(0,0,0,.85); color:#fff; font-size:9px; line-height:1.5; opacity:0; pointer-events:none; }
  #error-toast.show { opacity:1; }
